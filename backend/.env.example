# Copy to backend/.env for local development. Production values live in Secret Manager.
ENVIRONMENT=development
APP_BASE_URL=http://localhost:5173
DATABASE_URL=sqlite:///./eldercare.db
SECRET_KEY=replace-with-64-random-characters-for-anything-but-local-dev
EMAIL_TRANSPORT=console
RUN_INPROCESS_SCHEDULER=true
JOB_TRIGGER_TOKEN=dev-local-token
